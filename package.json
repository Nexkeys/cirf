{
  "name": "cirf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file=.env server/dev.js",
    "emulators": "npx --yes firebase-tools@15.30.0 emulators:start --only auth,firestore --project demo-cirf",
    "dev:api:emulators": "node --watch --env-file=.env.emulators server/dev.js",
    "dev:emulators": "vite --mode emulators",
    "seed:emulators": "node --env-file=.env.emulators scripts/seed-emulators.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "test": "node --test \"server/**/*.test.js\"",
    "test:e2e": "npx --yes firebase-tools@15.30.0 emulators:exec --only auth,firestore --project demo-cirf \"node --test server/e2e/lifecycle.e2e.js\""
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "cloudinary": "^2.11.0",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.45.0",
    "multer": "^2.3.0",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  }
}

# Settings for running CIRF on the local Firebase emulators. Nothing here is secret, and
# nothing reaches the real Firebase project. Used by:
#   npm run emulators           Auth + Firestore emulators
#   npm run dev:api:emulators   the API, pointed at the emulators
#   npm run dev:emulators       Vite (loads this file through --mode emulators)

# API (server side)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-cirf
API_PORT=3001

# Browser: sign in through the Auth emulator, as the same demo project the API expects
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_PROJECT_ID=demo-cirf

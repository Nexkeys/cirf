# Copy to .env and fill in. Never commit .env.

# ---- Server only (Vercel env vars). Never prefix these with VITE_ ----
FIREBASE_PROJECT_ID=
# On Vercel, paste client_email and private_key from the service account JSON:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Locally you can point at the downloaded JSON key instead of the two above:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin-sdk-.json
# The Firebase web API key (public by design). The API uses it to check passwords for
# phone-number sign-in.
FIREBASE_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port for `npm run dev:api` (Vite proxies /api to it)
API_PORT=3001

# ---- Frontend build (public by design, only used for Firebase Auth sign-in) ----
# vite.config.js passes exactly these four to the browser. If a VITE_ one is missing it
# uses the same value without the prefix (FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN,
# FIREBASE_PROJECT_ID, FIREBASE_APP_ID), so there's no need to set both.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

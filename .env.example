# Copy to .env and fill in. Never commit .env.

# ---- Server only (Vercel env vars). Never prefix these with VITE_ ----
FIREBASE_PROJECT_ID=
# On Vercel, paste client_email and private_key from the service account JSON:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Locally you can point at the downloaded JSON key instead of the two above:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin-sdk-.json

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port for `npm run dev:api` (Vite proxies /api to it)
API_PORT=3001

# ---- Frontend build (public by design, only used for Firebase Auth sign-in) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
